{
  "name": "@kujolang/kujo-cmd",
  "version": "0.2.0",
  "description": "Local-first Kujo Ability and Agent Skills integration for Command Code.",
  "type": "module",
  "bin": {
    "kujo-cmd": "bin/kujo-cmd.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "catalog/",
    "assets/",
    ".generated/",
    "scripts/check-command-code-host.mjs",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build-release.mjs",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test tests/catalog.test.mjs tests/executor.test.mjs tests/runtime.test.mjs tests/security.test.mjs tests/setup.test.mjs tests/release.test.mjs",
    "test:e2e": "node tests/e2e.test.mjs",
    "test:command-code": "node scripts/check-command-code-host.mjs"
  },
  "dependencies": {
    "@kujolang/kujo-runtime": "1.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kujolang/kujo-cmd.git"
  },
  "homepage": "https://github.com/kujolang/kujo-cmd#readme",
  "bugs": {
    "url": "https://github.com/kujolang/kujo-cmd/issues"
  },
  "keywords": [
    "kujo",
    "command-code",
    "mcp",
    "agent-skills",
    "ability"
  ]
